# Public Supabase project URL, for example https://PROJECT.supabase.co.
# Required for browser and server data access. If missing, users see a generic Hebrew error.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Required for browser reads. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Required for server writes and privileged reads.
# Never expose this to the client, and never use it to sign sessions or encrypt invite tokens.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for host session cookies (lolo_host_session). Required for host login.
# Also used only to decrypt invite links that were encrypted before INVITE_TOKEN_SECRET existed.
# Must be different from INVITE_TOKEN_SECRET and ADMIN_SESSION_SECRET.
# Generate a value with: openssl rand -base64 32
HOST_SESSION_SECRET=

# HMAC secret for guest invite sessions, and the key material for new invite_token_enc values.
# Required. Existing invite links keep working through invite_token_hash even if this cannot decrypt old rows.
# Must be different from HOST_SESSION_SECRET and ADMIN_SESSION_SECRET.
# Generate a value with: openssl rand -base64 32
INVITE_TOKEN_SECRET=

# HMAC secret for admin session cookies (lolo_admin_session). Required for admin login.
# Must be different from HOST_SESSION_SECRET and INVITE_TOKEN_SECRET.
# Generate a value with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Password for the /admin area. Required for a successful admin login. This is not a signing secret.
LOLO_ADMIN_PASSWORD=

# Optional public origin used when building absolute invite links, for example https://your-domain.
# If missing, the app uses the request origin.
NEXT_PUBLIC_APP_URL=

# Optional payment provider id. Leave unset for demo checkout (תשלום הדגמה).
# Demo checkout never charges a real card and needs no extra configuration.
# Set to "none" only to keep orders pending without the demo pay button.
# A future live provider name selects that implementation once it exists.
# PAYMENT_PROVIDER=
